# ==============================================================================
# MedRAG Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# Supported backends: "groq" (recommended), "openai", "ollama", or "mock"
# ------------------------------------------------------------------------------
LLM_BACKEND=groq

# Groq API (High-speed open inference: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama / Local OpenAI-compatible server (Optional)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ------------------------------------------------------------------------------
# 2. Benchmark Dataset & Knowledge Corpus Directories
# Specify directories containing local copies of official benchmarks
# ------------------------------------------------------------------------------
# MedQA dataset directory containing {train,dev,test}.jsonl
MEDQA_DATA_DIR=data/medqa

# Directory containing official MedQA English medical textbooks (.txt files)
MEDQA_CORPUS_DIR=data/medqa/textbooks

# PubMedQA dataset directory containing ori_pqal.json or {train,dev,test}.json
PUBMEDQA_DATA_DIR=data/pubmedqa

# Optional external biomedical background literature corpus
PUBMED_CORPUS_DIR=data/pubmedqa/corpus

# ------------------------------------------------------------------------------
# 3. Environment & Execution Controls
# ------------------------------------------------------------------------------
# Prevent duplicate OpenMP runtime warnings on Windows
KMP_DUPLICATE_LIB_OK=TRUE

# Disable online model downloads when using local cached HuggingFace models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Disable tokenizer multiprocessing warnings
TOKENIZERS_PARALLELISM=false

# Logging: DEBUG, INFO, WARNING, ERROR
MEDRAG_LOG_LEVEL=INFO
MEDRAG_LOG_JSON=0
